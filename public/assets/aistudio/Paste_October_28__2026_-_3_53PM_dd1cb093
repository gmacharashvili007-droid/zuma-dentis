import { motion, AnimatePresence } from 'framer-motion';

// Character-wise slide animation component for button (matching Header button effect)
const RollingText: React.FC<{ text: string; isHovered: boolean }> = ({ text, isHovered }) => {
  return (
    <span
      style={{
        display: 'inline-flex',
        alignItems: 'center',
        justifyContent: 'center',
        position: 'relative',
        overflow: 'hidden',
        height: '26px',
        lineHeight: '26px',
      }}
    >
      {text.split('').map((char, index) => {
        const isSpace = char === ' ';
        return (
          <span
            key={index}
            style={{
              display: 'inline-block',
              position: 'relative',
              overflow: 'hidden',
              height: '26px',
              lineHeight: '26px',
              width: isSpace ? '0.34em' : 'auto',
            }}
          >
            {/* Top primary character moving up on hover */}
            <motion.span
              style={{
                display: 'inline-block',
                willChange: 'transform',
              }}
              animate={{
                y: isHovered ? '-100%' : '0%',
              }}
              transition={{
                duration: 0.28,
                delay: index * 0.015,
                ease: [0.33, 1, 0.68, 1],
              }}
            >
              {isSpace ? '\u00A0' : char}
            </motion.span>

            {/* Bottom duplicate character sliding up into view */}
            <motion.span
              style={{
                display: 'inline-block',
                position: 'absolute',
                left: 0,
                top: 0,
                willChange: 'transform',
              }}
              initial={{ y: '100%' }}
              animate={{
                y: isHovered ? '0%' : '100%',
              }}
              transition={{
                duration: 0.28,
                delay: index * 0.015,
                ease: [0.33, 1, 0.68, 1],
              }}
            >
              {isSpace ? '\u00A0' : char}
            </motion.span>
          </span>
        );
      })}
    </span>
  );
};

